# Generated locally by tools/init_env.py. Never commit .env.
DJANGO_ENV=local
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-django-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=false
POSTGRES_DB=inf2006
POSTGRES_USER=inf2006
POSTGRES_PASSWORD=replace-database-password
POSTGRES_ADMIN_PASSWORD=replace-admin-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
APP_PORT=8000
# Production only: mounted trusted RDS CA certificate; Compose is local-only.
POSTGRES_SSLROOTCERT=
