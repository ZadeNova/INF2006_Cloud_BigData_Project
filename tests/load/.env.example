# Copy to .env (git-ignored) and fill in. Placeholders only: never commit real values.
# Load them with:  set -a; . ./.env; set +a
#
# Password shared by the synthetic test accounts. Generate one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
LOADTEST_PASSWORD=change-me
# Accounts are named <prefix>-a-0001 (cart abandoners) and <prefix>-b-0001 (buyers).
LOADTEST_PREFIX=loadtest
# Target. Only our own hosts are accepted (shop-ec2 / shop-fargate .fourtytwofactors.me, localhost).
LOAD_BASE_URL=https://shop-ec2.fourtytwofactors.me

# Only if the shop is under another domain: the same value as domain_name in src/infrastructure/base/terraform.tfvars.
# The harness refuses any host other than shop-ec2.<domain> and shop-fargate.<domain> (and localhost).
# LOAD_DOMAIN=fourtytwofactors.me
